            },
            "name": {
              "first": "Johnathan",
              "middle": "Alfred",
              "last": "Doe",
              "suffix": "Jr."
            },
            "activities": [
              {
                "category": "community_service",
                "hours": "80",
                "period_start": "2025-08-01",
                "period_end": "2025-08-31",
                "employer": "Community Center",
                "verification_status": "verified"
              }
            ],
            "date_of_birth": "1980-01-01",
