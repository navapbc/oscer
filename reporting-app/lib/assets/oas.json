{
  "components": {
    "securitySchemes": {
      "hmac": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "HMAC-SHA256 signature. Format: HMAC sig={base64_encoded_signature}. The signature is computed from the request body using the shared secret key."
      }
    },
    "schemas": {
      "CertificationCreateRequestBody": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "description": "An identifier for the person receiving benefits"
          },
          "case_number": {
            "type": ["string", "null"],
            "description": "An identifier for the case associated with the certification"
          },
          "application_date": {
            "type": ["string", "null"],
            "format": "date",
            "description": "The date of the application"
          },
          "certification_requirements": {
            "oneOf": [
              { "$ref": "#/components/schemas/CertificationRequirements" },
              { "$ref": "#/components/schemas/CertificationRequirementParameters" },
              { "$ref": "#/components/schemas/CertificationRequirementTypeParameters" }
            ]
          },
          "member_data": {
            "oneOf": [
              { "$ref": "#/components/schemas/CertificationMemberData" },
              { "type": "null" }
            ]
          },
          "household_data": {
            "oneOf": [
              { "$ref": "#/components/schemas/CertificationHouseholdData" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "member_id",
          "certification_requirements"
        ],
        "examples": {
          "fully_specified_certification_requirements": {
            "value": {
              "member_id": "123",
              "case_number": "C-111",
              "certification_requirements": {
                "certification_date": "2025-09-26",
                "certification_period_start": "2025-04-01",
                "certification_period_end": "2025-09-30",
                "number_of_months_to_certify": 1,
                "due_date": "2025-10-26",
                "months_that_can_be_certified": [
                  "2025-06-01",
                  "2025-07-01",
                  "2025-08-01"
                ]
              },
              "member_data": {
                "account_email": "john@doe.com",
                "contact": {
                  "email": "john@doe.com",
                  "phone": "+123456789"
                },
                "name": {
                  "first": "Johnathan",
                  "middle": "Alfred",
                  "last": "Doe",
                  "suffix": "Jr."
                },
                "activities": [
                  {
                    "category": "community_service",
                    "hours": "20",
                    "period_start": "2025-08-01",
                    "period_end": "2025-08-31",
                    "employer": "Community Center",
                    "verification_status": "verified"
                  },
                  {
                    "category": "education",
                    "credit_hours": "9",
                    "enrollment_status": "full_time",
                    "period_start": "2025-08-01",
                    "period_end": "2025-08-31",
                    "name": "State University",
                    "verification_status": "verified"
                  }
                ],
                "date_of_birth": "1980-01-01",
                "race_ethnicity": "Hispanic",
                "pregnancy_status": false
              }
            }
          },
          "without_explicit_months_that_can_be_certified_and_due_date": {
            "value": {
              "member_id": "123",
              "case_number": "C-111",
              "certification_requirements": {
                "certification_date": "2025-09-26",
                "certification_period_start": "2025-04-01",
                "certification_period_end": "2025-09-30",
                "lookback_period": 3,
                "number_of_months_to_certify": 1,
                "due_period_days": 30
              },
              "member_data": {
                "account_email": "john@doe.com",
                "contact": {
                  "email": "john@doe.com",
                  "phone": "+123456789"
                },
                "name": {
                  "first": "Johnathan",
                  "middle": "Alfred",
                  "last": "Doe",
                  "suffix": "Jr."
                },
                "date_of_birth": "1980-01-01",
                "race_ethnicity": "Hispanic",
                "pregnancy_status": false
              }
            }
          },
          "certification_type": {
            "value": {
              "member_id": "123",
              "case_number": "C-111",
              "certification_requirements": {
                "certification_date": "2025-09-26",
                "certification_type": "new_application"
              },
              "member_data": {
                "account_email": "john@doe.com",
                "contact": {
                  "email": "john@doe.com",
                  "phone": "+123456789"
                },
                "name": {
                  "first": "Johnathan",
                  "middle": "Alfred",
                  "last": "Doe",
                  "suffix": "Jr."
                },
                "date_of_birth": "1980-01-01",
                "race_ethnicity": "Hispanic",
                "pregnancy_status": false
              }
            }
          }
        }
      },
      "CertificationRequirements": {
        "type": "object",
        "description": "Description of certification needs",
        "properties": {
          "certification_date": {
            "type": "string",
            "format": "date",
            "description": "The date of the certification"
          },
          "certification_period_start": {
            "type": ["string", "null"],
            "format": "date",
            "description": "First day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application, which has no prior coverage period."
          },
          "certification_period_end": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Last day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application."
          },
          "certification_type": {
            "type": ["string", "null"],
	    "enum": [
	      "new_application",
	      "recertification",
	      "change_in_circumstance",
	      null
	    ],
            "description": "The type of certification"
          },
          "months_that_can_be_certified": {
            "type": ["array", "null"],
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "The list of months the Member can choose from"
          },
          "number_of_months_to_certify": {
            "type": ["integer", "null"],
            "description": "The number of months the Member needs to certify"
          },
          "due_date": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date by which the Member must have submitted their evidence"
          },
	  "seasonal_worker": {
	    "type": ["boolean", "null"],
	    "description": "Whether the member is a seasonal worker"
	  },
	  "self_employed": {
	    "type": ["boolean", "null"],
	    "description": "Whether the member is self employed"
	  }
        },
        "required": [
          "certification_date"
        ]
      },
      "CertificationRequirementParameters": {
        "type": "object",
        "properties": {
          "certification_date": {
            "type": "string",
            "format": "date",
            "description": "The date of the certification"
          },
          "certification_period_start": {
            "type": ["string", "null"],
            "format": "date",
            "description": "First day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application, which has no prior coverage period."
          },
          "certification_period_end": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Last day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application."
          },
          "lookback_period": {
            "type": "integer",
            "description": "The number of months before `certification_date` the Member can choose from"
          },
          "number_of_months_to_certify": {
            "type": "integer",
            "description": "The number of months the Member needs to certify"
          },
          "due_period_days": {
            "type": "integer"
          },
          "due_date": {
            "type": [ "string", "null" ],
            "format": "date",
            "description": "Date by which the Member must have submitted their evidence"
          }
        },
        "required": [
          "certification_date",
          "lookback_period",
          "number_of_months_to_certify"
        ]
      },
      "CertificationRequirementTypeParameters": {
        "type": "object",
        "properties": {
          "certification_date": {
            "type": "string",
            "format": "date",
            "description": "The date of the certification"
          },
          "certification_period_start": {
            "type": ["string", "null"],
            "format": "date",
            "description": "First day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application, which has no prior coverage period."
          },
          "certification_period_end": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Last day of the member's active certification period. Supplied for recertification and change in circumstance; absent for a new application."
          },
          "certification_type": {
            "type": "string",
	    "enum": [
	      "new_application",
	      "recertification",
	      "change_in_circumstance"
	    ],
            "description": "The type of certification"
          }
        },
        "required": [
          "certification_date",
          "certification_type"
        ]
      },
      "CertificationMemberData": {
        "type": "object",
        "description": "Description of member",
        "properties": {
          "account_email": {
            "type": ["string", "null"],
            "format": "email",
            "description": "The email of the Medicare account for the member"
          },
          "contact": {
            "type": ["object", "null"],
            "description": "Contact information of the member",
            "properties": {
              "email": {
                "type": ["string", "null"],
                "format": "email"
              },
              "phone": {
                "type": ["string", "null"],
                "pattern": "^\\+\\d{1,3}\\s\\d{1,14}(\\s\\d{1,13})?$"
              }
            }
          },
          "name": {
            "type": ["object", "null"],
            "description": "The name of the member",
            "properties": {
              "first": {
                "type": ["string", "null"]
              },
              "middle": {
                "type": ["string", "null"]
              },
              "last": {
                "type": ["string", "null"]
              },
              "suffix": {
                "type": ["string", "null"]
              }
            }
          },
          "address": {
            "type": ["object", "null"],
            "description": "The address of the member",
            "properties": {
	      "street_line_1": {
		"type": "string"
	      },
              "street_line_2": {
                "type": ["string", "null"]
              },
	      "city": {
		"type": "string"
	      },
	      "state": {
		"type": "string"
	      },
	      "zip_code": {
		"type": "string"
	      }
            }
          },
          "payroll_accounts": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationMemberDataPayrollAccount"
            }
          },
          "activities": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationMemberDataActivity"
            },
            "description": "Community engagement activities performed by the member"
          },
          "exemptions": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationMemberDataExemption"
            },
            "description": "Exemption data for the member"
          },
          "date_of_birth": {
            "type": ["string", "null"],
            "format": "date",
            "description": "The date of birth of the member"
          },
          "race_ethnicity": {
            "type": ["string", "null"],
            "description": "The race or ethnicity of the member"
          },
          "pregnancy_due_or_parturition_date": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Pregnancy due (future) or parturation (past) date"
          }
        }
      },
      "CertificationMemberDataPayrollAccount": {
        "type": "object",
        "description": "Description of a payroll",
        "properties": {
          "company_name": {
            "type": "string"
          },
          "paychecks": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationMemberDataPayrollAccountPaycheck"
            }
          }
        }
      },
      "CertificationMemberDataPayrollAccountPaycheck": {
        "type": "object",
        "description": "Description of a paycheck",
        "properties": {
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "gross": {
            "type": ["string", "null"],
            "format": "decimal"
          },
          "net": {
            "type": ["string", "null"],
            "format": "decimal"
          },
          "hours_worked": {
            "type": ["string", "null"],
            "format": "decimal"
          }
        },
        "required": [
          "period_start",
          "period_end"
        ]
      },
      "CertificationMemberDataActivity": {
        "type": "object",
        "description": "Community engagement activity. There is no type discriminator: which values are present decides what is recorded. An activity may report hours, gross income, or both",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["employment", "community_service", "education", "unearned"],
            "description": "The category of activity"
          },
          "hours": {
            "type": ["string", "null"],
            "format": "decimal",
            "description": "Number of hours for the activity; required unless the activity reports gross_income, or is an education activity reporting credit_hours or enrollment_status"
          },
          "credit_hours": {
            "type": ["string", "null"],
            "format": "decimal",
            "description": "Number of credit hours for an education activity, converted to hours on intake. Permitted only on education activities, and ignored when hours is also supplied"
          },
          "enrollment_status": {
            "type": ["string", "null"],
            "enum": ["full_time", "half_time", "less_than_half_time", null],
            "description": "Enrollment status for an education activity. Permitted only on education activities. Enrollment of full_time or half_time meets the community engagement requirement on its own, whatever hours are reported"
          },
          "gross_income": {
            "type": ["string", "null"],
            "format": "decimal",
            "description": "Gross income for the period. May be reported alongside hours, in which case one record per month is created carrying both values"
          },
          "source": {
            "type": ["string", "null"],
            "enum": ["api", null],
            "description": "Data source type; required when gross_income is supplied"
          },
          "reported_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the external source reported this data"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "description": "Start date of the activity period"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "description": "End date of the activity period"
          },
          "employer": {
            "type": ["string", "null"],
            "description": "Employer or organization associated with the activity"
          },
          "name": {
            "type": ["string", "null"],
            "description": "Name of the school or organization associated with the activity, where employer does not apply. Recorded as the employer when employer is not supplied"
          },
          "verification_status": {
            "type": "string",
            "enum": ["verified", "self_attested", "pending"],
            "description": "Verification status of the activity; only verified activities count toward the certification"
          }
        },
        "required": [
          "category",
          "period_start",
          "period_end",
          "verification_status"
        ],
        "anyOf": [
          {
            "required": ["hours"]
          },
          {
            "required": ["gross_income"]
          },
          {
            "properties": {
              "category": {
                "const": "education"
              }
            },
            "required": ["credit_hours"]
          },
          {
            "properties": {
              "category": {
                "const": "education"
              }
            },
            "required": ["enrollment_status"]
          }
        ]
      },
      "CertificationMemberDataExemption": {
        "type": "object",
        "description": "Data point for assessing if an exemption applies",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
	      "american_indian_or_alaska_native",
	      "caregiver_child",
	      "former_foster_care",
	      "pregnancy",
	      "postpartum",
	      "incarceration",
	      "caregiver_disability",
	      "meeting_atap_work",
	      "meeting_tanf_or_snap_work",
	      "veteran_disability",
	      "medical_condition",
	      "substance_treatment",
	      "travel_for_medical",
	      "inpatient_medical_care",
	      "declared_emergency_county",
	      "high_unemployment_county",
	      "other_program"
	    ],
            "description": "Exemption data type"
          },
	  "value": {
	    "type": "boolean",
	    "description": "Whether the exemption applies to the member"
	  },
	  "periods": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationMemberDataExemptionPeriod"
            }
	  },
	  "verification_status": {
	    "type": "string",
	    "enum": [
	      "verified",
	      "unverified",
	      "pending"
	    ],
	    "description": "The verification status of the exemption"
	  }
	},
	"required": [
	  "value",
	  "verification_status"
	]
      },
      "CertificationMemberDataExemptionPeriod": {
        "type": "object",
        "description": "Start and/or end of a period of time",
        "properties": {
          "period_start": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Start date of the exemption period"
          },
          "period_end": {
            "type": ["string", "null"],
            "format": "date",
            "description": "End date of the exemption period"
          }
	}
      },
      "CertificationHouseholdData": {
        "type": "object",
        "description": "Data about members of a household",
        "properties": {
          "members": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CertificationHouseholdDataMember"
            }
          }
	}
      },
      "CertificationHouseholdDataMember": {
        "type": "object",
        "description": "Data about a member of a household",
        "properties": {
          "name": {
            "type": ["object", "null"],
            "description": "The name of the household member",
            "properties": {
              "first": {
		"type": ["string", "null"]
              },
              "middle": {
		"type": ["string", "null"]
              },
              "last": {
		"type": ["string", "null"]
              },
              "suffix": {
		"type": ["string", "null"]
              }
            }
          },
          "ssn": {
            "type": ["string", "null"],
            "description": "The nine-digit Social Security Number of the household member. Dashes are accepted and stripped."
          },
          "date_of_birth": {
            "type": ["string", "null"],
            "format": "date",
            "description": "The date of birth of the household member"
          },
          "gross_incomes": {
            "type": ["array", "null"],
            "description": "The gross income reported for the household member, one entry per period",
            "items": {
              "$ref": "#/components/schemas/CertificationHouseholdDataMemberIncome"
            }
          }
	}
      },
      "CertificationHouseholdDataMemberIncome": {
        "type": "object",
        "description": "Gross income reported for a household member over a single period",
        "properties": {
          "gross_income": {
            "type": "string",
            "format": "decimal",
            "description": "Gross income for the period, greater than zero"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "description": "The first day of the period the income covers"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "description": "The last day of the period the income covers"
          }
        },
        "required": [
          "gross_income",
          "period_start",
          "period_end"
        ]
      },
      "CertificationOutcome": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["compliant", "excluded", "excepted", "exempt", "indeterminate", "not_compliant"],
            "description": "Current status of community engagement requirement checks"
          },
          "reason": {
            "type": ["string", "null"],
            "description": "Which exclusion, exemption, or community engagement requirement led to the decision"
          },
          "source": {
            "type": ["string", "null"],
            "description": "Which source provided the reason"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the status was set"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "CertificationResponseBody": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier for the certification record"
          },
          "member_id": {
            "type": "string",
            "description": "An identifier for the person receiving benefits"
          },
          "case_number": {
            "type": ["string", "null"],
            "description": "An identifier for the case associated with the certification"
          },
          "certification_requirements": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "#/components/schemas/CertificationRequirements" },
                  {
                    "type": "object",
                    "properties": {
                      "params": {
                        "type": ["object", "null"],
                        "description": "Additional parameters for the certification requirements"
                      }
                    }
                  }
                ]
              },
              { "type": "null" }
            ]
          },
          "member_data": {
            "anyOf": [
              { "$ref": "#/components/schemas/CertificationMemberData" },
              { "type": "null" }
            ]
          },
          "outcome": {
            "anyOf": [
              { "$ref": "#/components/schemas/CertificationOutcome" },
              { "type": "null" }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "member_id",
          "created_at",
          "updated_at"
        ],
        "example": {
