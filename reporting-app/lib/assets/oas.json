        }
      },
      "ErrorResponseBody": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          }
        },
        "example": {
          "errors": ["Not found"]
        }
      }
    }
  }
}
